# Pylint configuration for the Flask Image Recognition project.
# Starts from Pylint's defaults and only overrides what this project needs.

[MAIN]
# Fail the run (non-zero exit code) when the score drops below this value.
# Used by both pre-commit and the GitHub Actions workflow.
fail-under=9.0

# Never lint the local virtual environment or tool caches.
ignore=venv,.venv,__pycache__,.pytest_cache

# TensorFlow ships compiled extensions; allow pylint to introspect them so it
# does not report false "no-member" errors on tf/keras objects.
extension-pkg-allow-list=tensorflow

jobs=0

[FORMAT]
# 100 characters keeps code readable while allowing descriptive test names.
max-line-length=100

[BASIC]
# Short names that are conventional in this codebase.
good-names=i,j,e,app,img

[SIMILARITIES]
# Test modules legitimately repeat small request-building blocks; only report
# genuinely large copy-paste blocks.
min-similarity-lines=12
ignore-imports=yes

[MESSAGES CONTROL]
# redefined-outer-name: pytest injects fixtures by parameter name, so a test
# argument named "client" always "redefines" the fixture function. This is the
# documented pytest idiom, not a bug.
disable=redefined-outer-name

[REPORTS]
output-format=text
reports=no
score=yes
